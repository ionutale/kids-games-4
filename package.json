{
	"name": "cozy-nook",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy url cookie preferredLanguage baseLocale --emit-ts-declarations || echo '' && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run --passWithNoTests",
		"test:unit": "vitest",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"icons": "node scripts/generate-icons.mjs"
	},
	"dependencies": {
		"@fontsource/baloo-2": "^5.2.5",
		"@fontsource/nunito": "^5.2.5"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.18.2",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.4",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
